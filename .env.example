# 서버 주소/포트
HOST=0.0.0.0
PORT=3000

# SQLite 파일 위치
# Render 영구 디스크를 사용할 때: /var/data/construction-classroom.db
DB_PATH=./data/construction-classroom.db

# 교사 관리 로그인 아이디: 영문, 숫자, _, -, .만 사용
ADMIN_USERNAME=teacher

# 24자 이상의 충분히 긴 임의 문자열
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_CHARS_OR_MORE

# 먼저 npm install 후 아래 명령으로 생성합니다.
# npm run hash-password -- 원하는관리자비밀번호
ADMIN_PASSWORD_HASH=$2b$12$PASTE_YOUR_BCRYPT_HASH_HERE
TOKEN_EXPIRES_IN=4h

# 쉼표로 구분합니다.
# GitHub Pages를 함께 쓰면 https://사용자명.github.io 를 추가하세요.
# file://에서 연 index.html은 Origin이 null일 수 있습니다.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,null

# 요청 횟수 제한
PUBLIC_RATE_LIMIT=120
SUBMIT_RATE_LIMIT=20
ADMIN_RATE_LIMIT=40
